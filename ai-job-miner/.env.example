## ai-job-miner environment
## Copy to `.env` for local development.

# Redis connection (preferred single URL form)
REDIS_URL=redis://127.0.0.1:6379/0

# Or use host/port form if you prefer (leave REDIS_URL unset)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Persistent deduplication keys
JOB_DEDUP_REDIS_PREFIX=career_compass:ai_job_miner:dedup:hash:

# Dedupe retention window in seconds (default: 30 days)
JOB_DEDUP_TTL_SECONDS=2592000


## ai-job-miner environment
## Copy to `.env` for local development.

# HTTP service wrapper
SCRAPER_SERVICE_TOKEN=change-me-scraper-service-token
SCRAPER_DEFAULT_TIMEOUT=600

# Laravel callback/export API
# Local:  http://127.0.0.1:8000/api/v1
# Docker: http://nginx/api/v1
LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api/v1
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1/jobs/import
LARAVEL_API_CHECK_URL=http://127.0.0.1:8000/api/v1/jobs/import/check
LARAVEL_API_FAILED_URL=http://127.0.0.1:8000/api/v1/jobs/import/failed
LARAVEL_API_PROXIES_URL=http://127.0.0.1:8000/api/v1/proxies/active
LARAVEL_API_TOKEN=change-me-laravel-internal-token

# Optional Adzuna credentials. Missing values are reported as CONFIG_REQUIRED.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# External-risk sources can use the existing proxy system. Disable for diagnostics
# or local demos if proxies are unavailable.
SCRAPER_USE_PROXIES=true

# Redis connection (preferred single URL form)
REDIS_URL=redis://127.0.0.1:6379/0

# Or use host/port form if you prefer (leave REDIS_URL unset)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Persistent deduplication keys
JOB_DEDUP_REDIS_PREFIX=career_compass:ai_job_miner:dedup:hash:

# Dedupe retention window in seconds (default: 60 days)
JOB_DEDUP_TTL_SECONDS=5184000

# ============================================
# Phase 3 (Lite) — High-performance heuristics
# ============================================
# Skill matching threshold for fuzzy canonicalization (0..1)
SKILL_MATCH_THRESHOLD=0.85

# Optional: path to a JSON file containing the standard skills list
# (exported from Laravel `skills` table). Supported formats:
# - ["python","react",...]
# - {"skills":["python","react",...]}
STANDARD_SKILLS_PATH=

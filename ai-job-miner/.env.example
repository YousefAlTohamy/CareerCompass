## ai-job-miner environment
## Copy to `.env` for local development.

# Redis connection (preferred single URL form)
REDIS_URL=redis://127.0.0.1:6379/0

# Or use host/port form if you prefer (leave REDIS_URL unset)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Persistent deduplication keys
JOB_DEDUP_REDIS_PREFIX=career_compass:ai_job_miner:dedup:hash:

# Dedupe retention window in seconds (default: 60 days)
JOB_DEDUP_TTL_SECONDS=5184000

# ============================================
# Phase 3 — LLM fallback extraction
# ============================================
# Providers: disabled | openai | ollama
LLM_PROVIDER=disabled

# Model name for the selected provider:
# - OpenAI example: gpt-4o-mini
# - Ollama example: llama3.1
LLM_MODEL=gpt-4o-mini

# Hard safety limit to control costs (per engine run)
LLM_MAX_CALLS_PER_RUN=25
LLM_TIMEOUT_S=30

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Optional (leave empty for default OpenAI)
OPENAI_BASE_URL=

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Skill canonicalization fuzzy threshold (0..1)
SKILL_CANON_MIN_RATIO=0.88

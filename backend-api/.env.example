APP_NAME="Career Compass"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local/graduation demo admin seed only. Do not use this as production auth.
DEMO_ADMIN_NAME=Admin
DEMO_ADMIN_EMAIL=careercompassadmin@gmail.com
DEMO_ADMIN_PASSWORD=CareerCompassAdmin2026

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=career_compass
DB_USERNAME=cc_user
DB_PASSWORD=cc_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CV_STORAGE_DISK=local
CV_STORAGE_PREFIX=cv-uploads
CV_UPLOAD_RETENTION_DAYS=365
CV_TEMPORARY_URL_MINUTES=10
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=720

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional: shared URL-style Redis config (used by some services/tools)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

OTEL_SERVICE_NAME=career-compass-backend
REQUEST_ID_HEADER=X-Request-ID
MONITORING_TOKEN=
SLOW_REQUEST_MS=1000
MAX_JSON_PAYLOAD_BYTES=1048576
LOG_REQUEST_BODIES=false

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=true

# ============================================
# AI Engine Configuration
# Local:  http://127.0.0.1:8002
# Docker: http://ai-cv-analyzer:8000
# Handles: CV parsing, hybrid matching, health checks
# ============================================
AI_ENGINE_URL=http://127.0.0.1:8002
AI_ENGINE_TIMEOUT=120
AI_CV_ANALYZER_URL=http://127.0.0.1:8002

# Scraper Integration
# Local:  SCRAPER_SERVICE_URL=http://127.0.0.1:8003
# Docker: SCRAPER_SERVICE_URL=http://ai-job-miner:8000
# Laravel -> Python scraper service token. This must match SCRAPER_SERVICE_TOKEN in ai-job-miner.
SCRAPER_SERVICE_URL=http://127.0.0.1:8003
SCRAPER_SERVICE_TIMEOUT=600
SCRAPER_SERVICE_TOKEN=change-me-scraper-service-token

# Internal Laravel API URL used by the scraper callback/export pipelines.
# Local:  http://127.0.0.1:8000/api/v1
# Docker: http://nginx/api/v1
LARAVEL_INTERNAL_API_URL=http://127.0.0.1:8000/api/v1

# Python scraper -> Laravel internal API token. The ai-job-miner service calls this LARAVEL_API_TOKEN.
SCRAPY_API_TOKEN=change-me-laravel-internal-token

# Frontend API URL
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000


# Optional: if you run LLM extraction server-side later
# LLM_PROVIDER=disabled
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

VITE_APP_NAME="${APP_NAME}"

# Adzuna API Credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# External-risk scraper sources
SCRAPER_USE_PROXIES=true

# Internal machine callback limit for scraper imports
SCRAPER_RATE_LIMIT_PER_MINUTE=600

# Root compose variables for local Docker execution
SCRAPER_SERVICE_TOKEN=change-me-scraper-service-token
SCRAPY_API_TOKEN=change-me-laravel-internal-token
MONITORING_TOKEN=change-me-monitoring-token

MINIO_ROOT_USER=careercompass
MINIO_ROOT_PASSWORD=change-me-minio-password
GRAFANA_ADMIN_USER=careercompass
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

AWS_ACCESS_KEY_ID=careercompass
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=career-compass
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/career-compass
AWS_USE_PATH_STYLE_ENDPOINT=true

FILESYSTEM_DISK=local
CV_STORAGE_DISK=local
CV_STORAGE_PREFIX=cv-uploads
CV_UPLOAD_RETENTION_DAYS=365
CV_TEMPORARY_URL_MINUTES=10

VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://nginx

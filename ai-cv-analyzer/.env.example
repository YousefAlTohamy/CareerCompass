# ============================================
# CareerCompass AI Engine Configuration
# ============================================
# Docker exposes this service on host port 8000 and container port 8000.
# Running `python main.py` directly still starts the local development server on 8002.
# It handles:
#   - CV parsing         (POST /api/parse-cv)
#   - Hybrid matching    (POST /api/hybrid-match)
#   - Health check       (GET  /)

# Gemini API (for LLM-powered extraction)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of Gemini API keys for round-robin rotation
# GEMINI_API_KEYS=key1,key2,key3

# Hugging Face (for optional NER model downloads)
HF_TOKEN=your_hugging_face_token_here

# NER model path
NER_MODEL_PATH=./models/ner_weights/career_compass_ner_final

# CV processing timeout in seconds
# If a CV takes longer than this, a partial result is returned
CV_TIMEOUT_SECONDS=90
